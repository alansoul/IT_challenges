# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/it_challenges

# Redis (optional — leave blank to use MongoDB fallback)
REDIS_URL=

# Frontend (CORS + cookies)
FRONTEND_URL=http://localhost:3000

# Auth — generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=super_secret_jwt_random_key_replace_this_with_64_random_hex_characters

# Cloudinary (challenge assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / Password Reset (optional in dev) ─────────────────────────────
# Leave blank in local dev → link is printed to server console + returned as devLink
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="Cipher Cell CTF" <noreply@iiitnr.edu.in>

FRONTEND_URL=http://localhost:3000